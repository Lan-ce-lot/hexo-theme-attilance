<article class="<%= post.layout %>">
    <div class="inner">
        <div class="box post-box">
            <h2 class="post-title"><a href="<%- url_for(post.path) %>"><%= post.title %></a></h2>
            <span class="post-meta">
                <%= __('by') %>
                <%= post.author || config.author %>
                <% if (post.tags && post.tags.length) { %>
                    <%= __('in') %> <a class="post-meta-tag" href="<%- url_for(post.tags.data[0].path) %>"><%= post.tags.data[0].name %></a>
                <% } %>
                <%= __('on') %>
                <time datetime="<%= post.date.format('YYYY-MM-DD') %>"><%= post.date.format('DD MMM YYYY') %></time>
            </span>
            <%
              var excerptLimit = theme.excerpt_length || 120;
              var excerptText = strip_html(post.excerpt || '').replace(/\s+/g, ' ').trim();
              if (excerptText.length > excerptLimit) {
                var excerptCut = excerptText.slice(0, excerptLimit);
                var excerptSpace = excerptCut.lastIndexOf(' ');
                if (excerptSpace > excerptLimit * 0.6) excerptCut = excerptCut.slice(0, excerptSpace);
                excerptCut = excerptCut.replace(/[\s,，、;；:：]+$/g, '').trim();
                excerptText = excerptCut + '…';
              }
            %>
            <% if (excerptText) { %>
            <p class="post-excerpt"><%= excerptText %></p>
            <% } %>
        </div>
    </div>
</article>