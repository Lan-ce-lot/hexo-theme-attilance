<div class="nav-header">
  <nav class="nav-wrapper" aria-label="<%= __('nav.home') %>">
      <% if (config.logo) { %>
      <span class="logo">
          <a href="<%- url_for() %>" title="<%= __('nav.home') %>"><img src="<%= config.logo %>" alt="<%= config.title %>"></a>
      </span>
      <% } %>
      <ul>
        <% for (var label in theme.menu) { %>
            <li class="nav-<%= label.toLowerCase() %><% if (is_current(theme.menu[label])) { %> active<% } %>">
                <a href="<%- url_for(theme.menu[label]) %>"><span><%= label %></span></a>
            </li>
        <% } %>
    </ul>
      <ul class="nav-meta">
        <% if (theme.links && theme.links.twitter) { %>
        <li class="nav-twitter">
          <a aria-label="Twitter" href="<%= theme.links.twitter %>" title="Twitter" target="_blank">
            <i class="icon icon-twitter" aria-hidden="true"></i>
            <span>Twitter</span>
          </a>
        </li>
        <% } %>
        <% if (theme.links && theme.links.github) { %>
        <li class="nav-github">
          <a aria-label="GitHub" href="<%= theme.links.github %>" title="GitHub" target="_blank">
            <i class="fa fa-github" aria-hidden="true"></i>
            <span>GitHub</span>
          </a>
        </li>
        <% } %>
        <% if (theme.links && theme.links.facebook) { %>
        <li class="nav-facebook">
          <a aria-label="Facebook" href="<%= theme.links.facebook %>" title="Facebook" target="_blank">
            <i class="icon icon-facebook" aria-hidden="true"></i>
            <span>Facebook</span>
          </a>
        </li>
        <% } %>
      </ul>
  </nav>

  <div class="nav-wrapper-control">
      <div class="inner">
          <a class="nav-menu" role="button"><i class="icon icon-menu" aria-hidden="true"></i><%= __('menu') %></a>
      </div>
  </div>
</div>
