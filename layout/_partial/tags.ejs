<header class="post-header">
  <div class="inner">
    <h1 class="post-title"><%= page.title || __('topics') %></h1>
  </div>
</header>

<main class="content" role="main">
  <article class="post">
    <div class="inner">
      <%
        var tags = site.tags.filter(function(tag){ return tag.length }).toArray().sort(function(a, b){
          return b.length - a.length || a.name.localeCompare(b.name);
        });
      %>
      <% if (!tags.length) { %>
      <section class="post-content">
        <p><%= __('counter.tag_cloud.zero') %></p>
      </section>
      <% } else { %>
      <section class="tag-index" aria-label="<%= page.title || __('topics') %>">
        <% tags.forEach(function(tag){ %>
        <a href="<%- url_for(tag.path) %>"><%= tag.name %> <span><%= tag.length %></span></a>
        <% }) %>
      </section>
      <% } %>
    </div>
  </article>
</main>
