<%
  var cover = post.cover || post.banner;
  if (!cover && post.photos && post.photos.length) cover = post.photos[0];
  var shareUrl = full_url_for(post.path);
  var shareTitle = encodeURIComponent(post.title || '');
  var shareHref = encodeURIComponent(shareUrl);
  var primaryTag = post.tags && post.tags.length ? post.tags.data[0] : null;
  var minutes = 1;
  if (!isPage && post.content) {
    var chars = strip_html(post.content).replace(/\s+/g, '').length;
    minutes = Math.max(1, Math.round(chars / 400));
  }
  function navExcerpt(item) {
    var text = strip_html(item.excerpt || item.content || '').replace(/\s+/g, ' ').trim();
    if (text.length > 48) return text.slice(0, 48).trim() + '…';
    return text;
  }
%>
<% if (!isPage) { %>
<div class="progress-container">
  <span class="progress-bar"></span>
</div>
<% } %>

<header class="post-header <% if (cover) { %>has-cover<% } %>">
  <div class="inner">
    <% if (!isPage) { %>
    <span class="post-info">
      <span class="post-type"><%= __('article') %></span>
      <% if (primaryTag) { %>
      <span class="post-count"><%= primaryTag.name %></span>
      <% } %>
    </span>
    <% } %>
    <h1 class="post-title"><%= post.title %></h1>
    <% if (!isPage) { %>
    <div class="post-meta">
      <div class="post-meta-avatars">
        <figure class="post-meta-avatar avatar">
          <a href="<%- url_for('/') %>" class="author-avatar">
            <img class="author-profile-image" src="<%= url_for(theme.avatar) %>" alt="<%= post.author || config.author %>">
          </a>
        </figure>
      </div>
      <h4 class="post-meta-author"><%= post.author || config.author %></h4>
      <time datetime="<%= post.date.format('YYYY-MM-DD') %>"><%= post.date.format('DD MMM YYYY') %></time>
      &bull; <%= minutes === 1 ? __('one_min_read') : (minutes + ' ' + __('min_read')) %>
    </div>
    <% } %>
    <% if (cover) { %>
    <div class="post-cover cover">
      <img src="<%= url_for(cover) %>" alt="<%= post.title %>">
    </div>
    <% } %>
  </div>
</header>

<main class="content" role="main">
  <article class="post">
    <div class="inner">
      <section class="post-content">
        <%- post.content %>
      </section>

      <% if (!isPage) { %>
      <section class="post-footer">
        <div class="post-share">
          <span class="post-info-label"><%= __('share') %></span>
          <a title="Twitter" aria-label="Twitter" class="twitter" href="https://twitter.com/share?text=<%= shareTitle %>&url=<%= shareHref %>" onclick="window.open(this.href, 'twitter-share', 'width=550,height=235');return false;">
            <i class="icon icon-twitter" aria-hidden="true"></i>
          </a>
          <a title="Facebook" aria-label="Facebook" class="facebook" href="https://www.facebook.com/sharer/sharer.php?u=<%= shareHref %>" onclick="window.open(this.href, 'facebook-share','width=580,height=296');return false;">
            <i class="icon icon-facebook" aria-hidden="true"></i>
          </a>
          <a title="LinkedIn" aria-label="LinkedIn" class="linkedin" href="https://www.linkedin.com/shareArticle?mini=true&url=<%= shareHref %>&title=<%= shareTitle %>" onclick="window.open(this.href, 'linkedin-share', 'width=930,height=720');return false;">
            <i class="icon icon-linkedin" aria-hidden="true"></i>
          </a>
          <a title="Email" aria-label="Email" class="email" href="mailto:?subject=<%= shareTitle %>&body=<%= shareHref %>">
            <i class="icon icon-mail" aria-hidden="true"></i>
          </a>
        </div>
        <% if (post.tags && post.tags.length) { %>
        <aside class="post-tags">
          <span class="post-info-label"><%= __('topic') %></span>
          <%- list_tags(post.tags, {
            show_count: false,
            class: 'post-tag',
            style: false,
            separator: ' '
          }) %>
        </aside>
        <% } %>
      </section>

      <% if (config.disqus_shortname || theme.disqus_shortname) { %>
      <section class="post-comments">
        <div id="disqus_thread"></div>
      </section>
      <% } %>
      <% if (theme.valine && theme.valine.enable && theme.valine.appId && theme.valine.appKey) { %>
      <section class="post-comments">
        <div class="vcomment"></div>
      </section>
      <% } %>

      <% if (post.prev || post.next) { %>
      <aside class="post-nav">
        <% if (post.prev) { %>
        <a class="post-nav-next" href="<%- url_for(post.prev.path) %>">
          <section class="post-nav-teaser">
            <i class="icon icon-arrow-left" aria-label="<%= __('newer_posts') %>"></i>
            <h2 class="post-nav-title"><%= post.prev.title %></h2>
            <p class="post-nav-excerpt"><%= navExcerpt(post.prev) %></p>
            <p class="post-nav-meta"><time datetime="<%= post.prev.date.format('YYYY-MM-DD') %>"><%= post.prev.date.format('DD MMM YYYY') %></time></p>
          </section>
        </a>
        <% } %>
        <% if (post.next) { %>
        <a class="post-nav-prev" href="<%- url_for(post.next.path) %>">
          <section class="post-nav-teaser">
            <i class="icon icon-arrow-right" aria-label="<%= __('older_posts') %>"></i>
            <h2 class="post-nav-title"><%= post.next.title %></h2>
            <p class="post-nav-excerpt"><%= navExcerpt(post.next) %></p>
            <p class="post-nav-meta"><time datetime="<%= post.next.date.format('YYYY-MM-DD') %>"><%= post.next.date.format('DD MMM YYYY') %></time></p>
          </section>
        </a>
        <% } %>
        <div class="clear"></div>
      </aside>
      <% } %>
      <% } %>
    </div>
  </article>
</main>
<script>
  document.addEventListener('DOMContentLoaded', function () {
    if (!window.jQuery) return;
    var $ = window.jQuery;
    var viewport = $(window);
    var post = $('.post-content');
    if (post.length && $.fn.fitVids) post.fitVids();

    function codestyling() {
      if (!window.hljs) return;
      $('pre code').each(function(i, e) {
        var cls = e.className || '';
        if (cls && !/\blanguage-|\blang-/.test(cls)) {
          e.className = 'language-' + cls.trim().split(/\s+/)[0];
        }
        hljs.highlightElement(e);
        if (!$(this).hasClass('language-text')) {
          var code = $(this);
          var lines = code.html().split(/\n(?!$)/g).length;
          var numbers = '';
          for (var n = 1; n <= lines; n++) {
            numbers += '<span class="line" aria-hidden="true">' + n + '</span>';
          }
          code.parent().append('<div class="lines">' + numbers + '</div>');
        }
      });
    }
    codestyling();

    <% if (!isPage) { %>
    function readingProgress() {
      if (!post.length || !post.height()) return;
      var postBottom = post.offset().top + post.height();
      var viewportHeight = viewport.height();
      var progress = 100 - (((postBottom - (viewport.scrollTop() + viewportHeight) + viewportHeight / 3) / (postBottom - viewportHeight + viewportHeight / 3)) * 100);
      $('.progress-bar').css('width', progress + '%');
      (progress > 100) ? $('.progress-container').addClass('complete') : $('.progress-container').removeClass('complete');
    }
    readingProgress();
    viewport.on({
      'scroll': readingProgress,
      'resize': readingProgress,
      'orientationchange': readingProgress
    });
    <% } %>
  });
</script>
