<% if (post.date) { %>
  <div class="<%= class_name %>">
    <% if (is_post()) { %>
      <time datetime="<%= date_xml(post.date) %>" class="dt-published" itemprop="datePublished"><%= date(post.date, config.date_format) %></time>
    <% } else { %>
      <% if (is_home() || is_archive()  ) { %>
        <time datetime="<%= date_xml(post.date) %>" class="dt-published" itemprop="datePublished"><%= date(post.date, config.date_format) %></time>
      <% } %>
    <% } %>
  </div>
<% } %>
