<%
  var showBlogHeader = is_home();
  var listType = '';
  var listTitle = '';
  var listCount = 0;

  if (is_tag()) {
    listType = __('topic');
    listTitle = page.tag;
    var tagObj = site.tags.findOne({name: page.tag});
    listCount = tagObj ? tagObj.length : page.posts.length;
  } else if (is_category()) {
    listType = __('category');
    listTitle = page.category;
    var catObj = site.categories.findOne({name: page.category});
    listCount = catObj ? catObj.length : page.posts.length;
  } else if (is_archive()) {
    listType = __('archive');
    if (is_month()) {
      listTitle = page.year + '/' + page.month;
    } else if (is_year()) {
      listTitle = String(page.year);
    } else {
      listTitle = __('archive');
    }
    listCount = 0;
    site.posts.each(function(item) {
      if (is_month() && (item.date.year() !== page.year || Number(item.date.format('M')) !== page.month)) return;
      if (is_year() && item.date.year() !== page.year) return;
      listCount += 1;
    });
  }
%>
<% if (showBlogHeader) { %>
<header class="blog-header <% if (theme.banner) { %>has-cover<% } %>">
  <div class="inner">
    <div class="box blog-box">
      <h1 class="blog-name"><%= config.title %></h1>
      <% if (theme.subtitle || config.subtitle) { %>
      <span class="blog-description"><%= theme.subtitle || config.subtitle %></span>
      <% } %>
    </div>
    <% if (theme.banner) { %>
    <div class="blog-cover cover">
      <img src="<%= url_for(theme.banner) %>" alt="<%= config.title %>">
    </div>
    <% } %>
  </div>
</header>
<% } else if (listTitle) { %>
<header class="blog-header <% if (theme.banner) { %>has-cover<% } %>">
  <div class="inner">
    <div class="archive archive-tag box archive-box">
      <span class="archive-info">
        <span class="archive-type"><%= listType %></span>
        <span class="archive-count"><%- _p('posts', listCount) %></span>
      </span>
      <h2 class="archive-title"><%= listTitle %></h2>
    </div>
    <% if (theme.banner) { %>
    <div class="blog-cover cover">
      <img src="<%= url_for(theme.banner) %>" alt="<%= listTitle %>">
    </div>
    <% } %>
  </div>
</header>
<% } %>

<div id="index" class="container">
  <main class="content" role="main">
    <%- partial('pagination', {extra: true}) %>
    <% page.posts.each(function(post){ %>
      <%- partial('min-article', {post: post, index: true}) %>
    <% }) %>
    <%- partial('pagination', {extra: false}) %>
  </main>
</div>
